# Copy to infra/compose/.env and fill in. That file is git-ignored.
# Everything here comes from your FirstPR GitHub App's page (see apps/README.md).

# Sign-in (API and worker)
FIRSTPR_GITHUB_CLIENT_ID=
FIRSTPR_GITHUB_CLIENT_SECRET=
# Encrypts GitHub tokens in the database. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIRSTPR_TOKEN_KEYS=

# Catalogue sync with the app's own token (worker)
FIRSTPR_GITHUB_APP_ID=
# The whole private key on one line, with \n where the line breaks are, in double quotes:
#   FIRSTPR_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
FIRSTPR_GITHUB_APP_PRIVATE_KEY=

# Start working (API): the app's URL name, from github.com/apps/<slug>
FIRSTPR_GITHUB_APP_SLUG=
# Optional: a repo of practice issues everyone's first pull request goes to (owner/name)
FIRSTPR_PRACTICE_REPO=

# Webhooks (API): the same secret you typed into the app's webhook settings
FIRSTPR_GITHUB_WEBHOOK_SECRET=

# Email through Resend (https://resend.com), API and worker. Empty: no email is sent.
FIRSTPR_RESEND_API_KEY=
# A sender on a domain you verified in Resend
FIRSTPR_EMAIL_FROM=FirstPR <hello@your-domain.dev>

# Product analytics (API and worker): a PostHog project key. Empty: no analytics.
FIRSTPR_POSTHOG_KEY=
FIRSTPR_POSTHOG_HOST=https://us.i.posthog.com

# Your GitHub login, to see /admin
FIRSTPR_ADMIN_LOGINS=

# --- Launch settings (Step 9) ---

# Error reports to Sentry (API and worker). Empty: none are sent.
FIRSTPR_SENTRY_DSN=
# development, staging or production
FIRSTPR_ENVIRONMENT=development

# Invite-only sign-in for the tester phase (API). Only these GitHub logins
# (comma-separated) and the admins can sign in while it is on.
FIRSTPR_INVITE_ONLY=false
FIRSTPR_INVITE_LOGINS=
# Where "Join the waiting list" points while sign-in is invite-only
FIRSTPR_WAITLIST_URL=

# Bearer token for /api/v1/metrics (Prometheus). Empty: metrics are off.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FIRSTPR_METRICS_TOKEN=

# Only for compose.prod.yaml (one server with HTTPS)
DOMAIN=
POSTGRES_PASSWORD=
# Where "Send feedback" goes. Empty: a new GitHub issue on this repo.
FEEDBACK_URL=
