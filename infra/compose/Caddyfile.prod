# Production proxy: HTTPS for {$DOMAIN} (certificate fetched and renewed by Caddy),
# /api to FastAPI, everything else to Next.js.
{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	handle /api/* {
		# Not compressed: gzip would hold back the live streams (server-sent events).
		reverse_proxy api:8000
	}
	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}

# Anyone typing www. ends up on the main address.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
